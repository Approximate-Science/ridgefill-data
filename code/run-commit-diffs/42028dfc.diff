+def doc_key(doc):
+    """A locked document's file stem <domain>_<nominal length>_<index> as a sort key: domain, length, index (another
+    stem sorts by itself)."""
+    m = re.fullmatch(r"(.+)_(\d+)_(\d+)", str(doc))
