+        return [FN_NOTE.format(image=tex_escape(e["image"]), protocol=e["protocol"],
+                               det=e["determinism"]["bitwise_equal"], docs=e["determinism"]["docs"],
+                               ctl=ctl.get("bitwise_equal", "--"), ctl_n=ctl.get("docs", "--"))]
