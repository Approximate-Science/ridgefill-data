index 0000000..da5ebe8
--- /dev/null
+++ b/c5/convert.py
@@ -0,0 +1,232 @@
+"""Convert the public RidgeFill release (TheCacheIsALie/RidgeFill-Projector-Qwen3.8-Flash-Next-i8 at 0b6f2ce0) into
+the format of tcclaviger's engine (vllm/v1/ced.py + vllm/models/qwen4_exp/amd/ced.py in tcclaviger/vllm:29.08.10).
+
+Release (ridgefill.json, split 24):
+  proj8.L<L>.safetensors   proj.L.codes int8 [2560, 10240], proj.L.scale bf16 [2560, 80], proj.L.bias bf16 [2560]
+                           (i8_row128: row i's 128-column group g is codes[i, 128g:128g+128] * scale[i, g])
+  correction.safetensors   st.L f32 [48, 128, 128] for the 18 late GDN layers: the mean terminal-state error,
+                           all heads, [heads, V, K]
+  rowsel.safetensors       score f32 [248320]: -log unigram frequency on the class56 tokens, -inf elsewhere
+Engine (one directory):
+  ridgefill-s24.safetensors    layer.L [2560, 10241] bf16 (map | bias), L = 24..47, and final [10240, 10241] bf16
+                               (boundary -> final_multi_hidden: read only for the approximated rows' logits and the
+                               MTP drafter's hidden; the release ships no final, see --final)
+  ridgefill-s24-st.rank<r>.pt  {"sum": {L: fp32 [heads/tp, V, K]}, "count": {L: 1}} per fit rank, as
+                               tools/ced/fit_st.py writes them; StCorrection concatenates the files' heads in rank
+                               order, divides by count and keeps its rank's slice, so sum / 1 is st.L exactly
+  freq.safetensors             logfreq f32 [248320] = -score (bitwise; XrowsSelector ranks by -logfreq), 0.0 where
+                               the release masks the id (-inf: not a class56 token, never read; c5/engine_check.py
+                               checks the engine's own class mask selects exactly the release's finite ids)
+  SHA256SUMS, CONVERSION.json
+Maps: codes * scale in fp32 (exact: an 8-bit code times an 8-bit-mantissa bf16 fits fp32's 24 bits), the bias
+appended in fp32, then one cast to bf16 (the engine's Projector casts every map to bf16 at load; this cast is the
+only rounding, and the engine would apply the same one to the fp32 map).
+Inputs are read from disk with O_DIRECT and checked against ridgefill.json / SHA256SUMS before use; the conversion
+runs twice from two reads and must agree byte for byte, and every output is read back from disk (O_DIRECT) and
+compared (the host's RAM flips bits: kva/integrity.py).
+
+Usage: python -m c5.convert --src <projector-src> --out <projector-tcc> [--final source --final-source <bf16 file>]
+"""
+import argparse
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+
+import torch
+from safetensors.torch import load as st_load, save as st_save
+
+from kva.integrity import read_direct
+
+RELEASE = "TheCacheIsALie/RidgeFill-Projector-Qwen3.8-Flash-Next-i8"
+REVISION = "0b6f2ce017fe912198c697bcc813a1578bc67ce1"
+MANIFEST_SHA256 = "795363fa153f0e7e16454af6acabd644709e703d84de0dd9535565226bb51faa"
+SPLIT, LAYERS, H, HC, GROUP = 24, 48, 2560, 4, 128
+WIDTH = HC * H
+GDN_HEADS, TP = 48, 2
+STEM = f"ridgefill-s{SPLIT}"
+ST_BASE = f"{STEM}-st"
+
+
+class ConversionError(RuntimeError):
+    pass
+
+
+def sha256(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def read_checked(path, want):
+    b = read_direct(str(path))
+    got = sha256(b)
+    if got != want:
+        raise ConversionError(f"{path}: sha256 {got}, expected {want}")
+    return b
+
+
+def load_release(src, manifest_sha256=MANIFEST_SHA256):
+    """(manifest, {name: bytes}) of every manifest file, each checked against ridgefill.json and SHA256SUMS."""
+    src = Path(src)
+    mb = read_direct(str(src / "ridgefill.json"))
+    if sha256(mb) != manifest_sha256:
+        raise ConversionError(f"{src}/ridgefill.json: sha256 {sha256(mb)}, expected {manifest_sha256}")
+    man = json.loads(mb)
+    sums = {}
+    if (src / "SHA256SUMS").is_file():
+        for line in read_direct(str(src / "SHA256SUMS")).decode().splitlines():
+            if line.strip():
+                h, name = line.split(None, 1)
+                sums[name.lstrip("*")] = h
+    files = {}
+    for name, h in man["files"].items():
+        if name in sums and sums[name] != h:
+            raise ConversionError(f"{name}: SHA256SUMS {sums[name]} != ridgefill.json {h}")
+        files[name] = read_checked(src / name, h)
+    if man["split"] != SPLIT or man["projector"]["layout"] != "i8_row128" or man["stream_width"] != WIDTH:
+        raise ConversionError(f"release geometry {man['split']} {man['projector']['layout']} {man['stream_width']}")
+    return man, files
+
+
+def dequant(codes, scale, bias):
+    """[rows, width + 1] fp32: codes * their row group's scale, then the bias column."""
+    rows, width = codes.shape
+    if codes.dtype != torch.int8 or width % GROUP or scale.shape != (rows, width // GROUP) or bias.shape != (rows,):
+        raise ConversionError(f"i8_row128 shapes {tuple(codes.shape)} {tuple(scale.shape)} {tuple(bias.shape)}")
+    w = codes.to(torch.float32).view(rows, width // GROUP, GROUP) * scale.to(torch.float32)[:, :, None]
+    return torch.cat([w.view(rows, width), bias.to(torch.float32)[:, None]], 1)
+
+
+def maps(man, files):
+    out = {}
+    for L in range(SPLIT, LAYERS):
+        t = st_load(files[man["projector"]["files"][str(L)]])
+        m = dequant(t[f"proj.{L}.codes"], t[f"proj.{L}.scale"], t[f"proj.{L}.bias"])
+        if m.shape != (H, WIDTH + 1):
+            raise ConversionError(f"layer {L}: {tuple(m.shape)}")
+        out[f"layer.{L}"] = m.to(torch.bfloat16).contiguous()
+    return out
+
+
+def final_map(kind, source, source_sha):
+    if kind == "zero":
+        return torch.zeros(WIDTH, WIDTH + 1, dtype=torch.bfloat16)
+    f = st_load(read_checked(source, source_sha))["final"]
+    if f.shape != (WIDTH, WIDTH + 1) or f.dtype != torch.bfloat16:
+        raise ConversionError(f"{source}: final {tuple(f.shape)} {f.dtype}")
+    return f.contiguous()
+
+
+def corrections(man, files):
+    """[{"sum": {L: fp32 [heads/TP, V, K]}, "count": {L: 1}} per rank], int layer keys (fit_st.py's)."""
+    t = st_load(files["correction.safetensors"])
+    layers = [int(x) for x in man["correction"]["layers"]]
+    if sorted(int(k.split(".")[1]) for k in t) != sorted(layers):
+        raise ConversionError(f"correction keys {sorted(t)} vs manifest layers {layers}")
+    local = GDN_HEADS // TP
+    ranks = []
+    for r in range(TP):
+        s = {}
+        for L in layers:
+            c = t[f"st.{L}"]
+            if c.shape != (GDN_HEADS, 128, 128) or c.dtype != torch.float32:
+                raise ConversionError(f"st.{L}: {tuple(c.shape)} {c.dtype}")
+            s[L] = c[r * local:(r + 1) * local].clone().contiguous()
+        ranks.append({"sum": s, "count": {L: 1 for L in layers}})
+    return ranks
+
+
+def freq(files):
+    """(logfreq [V], eligible ids): -score where finite, 0.0 where the release masks the id."""
+    sc = st_load(files["rowsel.safetensors"])["score"]
+    if sc.dtype != torch.float32 or sc.ndim != 1 or torch.isnan(sc).any() or torch.isposinf(sc).any():
+        raise ConversionError("rowsel score: expected f32 [V], finite or -inf")
+    masked = torch.isneginf(sc)
+    return torch.where(masked, torch.zeros_like(sc), -sc).contiguous(), int((~masked).sum())
+
+
+def one_key(meta):
+    """safetensors writes __metadata__ in hash order (several keys give different bytes run to run): one sorted JSON
+    string under one key keeps the file byte-reproducible. The engine reads no metadata key of ours (ced_st, ced_freq,
+    ced_xrows and taps stay absent: the arms name the correction and the table by environment)."""
+    return {"c5": json.dumps(meta, sort_keys=True)}
+
+
+def pt_bytes(obj):
+    buf = io.BytesIO()
+    torch.save(obj, buf)
+    return buf.getvalue()
+
+
+def build(src, final_kind, final_source=None, final_sha=None, manifest_sha256=MANIFEST_SHA256):
+    """{file name: bytes} of the engine directory (deterministic: the same inputs give the same bytes)."""
+    man, files = load_release(src, manifest_sha256)
+    tensors = maps(man, files)
+    tensors["final"] = final_map(final_kind, final_source, final_sha)
+    meta = {"format": "tcc-ced (vllm/models/qwen4_exp/amd/ced.py Projector)", "release": RELEASE,
+            "revision": REVISION, "release_manifest_sha256": manifest_sha256,
+            "maps": "layer.L = bf16(fp32(codes) * fp32(scale) | fp32(bias)) from proj8.L<L>.safetensors",
+            "final": (f"verbatim from {Path(final_source).name} (sha256 {final_sha}, the release's fit.proj_sha256)"
+                      if final_kind == "source" else "zero map (the release ships no final)")}
+    out = {f"{STEM}.safetensors": st_save(tensors, metadata=one_key(meta))}
+    for r, obj in enumerate(corrections(man, files)):
+        out[f"{ST_BASE}.rank{r}.pt"] = pt_bytes(obj)
+    logfreq, eligible = freq(files)
+    out["freq.safetensors"] = st_save({"logfreq": logfreq}, metadata=one_key({
+        "source": f"{RELEASE}@{REVISION} rowsel.safetensors score", "rule": "logfreq = -score; 0.0 where score = -inf",
+        "eligible": str(eligible)}))
+    report = {"release": RELEASE, "revision": REVISION, "release_manifest_sha256": manifest_sha256,
+              "split": SPLIT, "tp": TP, "final": final_kind,
+              "final_source": str(final_source) if final_kind == "source" else None,
+              "final_source_sha256": final_sha if final_kind == "source" else None,
+              "freq_eligible_ids": eligible, "inputs": {n: man["files"][n] for n in sorted(man["files"])},
+              "outputs": {n: sha256(b) for n, b in sorted(out.items())}}
+    out["CONVERSION.json"] = (json.dumps(report, indent=1) + "\n").encode()
+    return out
+
+
+def write(out_dir, blobs):
+    out_dir = Path(out_dir)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    for name, b in blobs.items():
+        tmp = out_dir / f".{name}.tmp"
+        with open(tmp, "wb") as f:
+            f.write(b)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp, out_dir / name)
+    (out_dir / "SHA256SUMS").write_text("".join(f"{sha256(b)}  {n}\n" for n, b in sorted(blobs.items())))
+
+
+def convert(src, out, final_kind="source", final_source=None, manifest_sha256=MANIFEST_SHA256):
+    man = json.loads(read_direct(str(Path(src) / "ridgefill.json")))
+    final_sha = man["fit"]["proj_sha256"]
+    first = build(src, final_kind, final_source, final_sha, manifest_sha256)
+    second = build(src, final_kind, final_source, final_sha, manifest_sha256)   # a second read: RAM faults differ
+    bad = [n for n in first if sha256(first[n]) != sha256(second[n])]
+    if bad:
+        raise ConversionError(f"two conversions disagree on {bad}: host RAM fault, run again")
+    write(out, first)
+    back = {n: sha256(read_direct(str(Path(out) / n))) for n in first}
+    bad = [n for n in first if back[n] != sha256(first[n])]
+    if bad:
+        raise ConversionError(f"read-back differs on {bad}")
+    return back
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--src", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--final", choices=("source", "zero"), default="source")
+    ap.add_argument("--final-source", default="")
+    a = ap.parse_args(argv)
+    if a.final == "source" and not a.final_source:
+        ap.error("--final source needs --final-source (the bf16 file whose sha256 is the release's fit.proj_sha256)")
+    for name, h in sorted(convert(a.src, a.out, a.final, a.final_source).items()):
+        print(h, name)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/c5/engine_check.py b/c5/engine_check.py
new file mode 100644
index 0000000..0a96dec
--- /dev/null
+++ b/c5/engine_check.py
@@ -0,0 +1,193 @@
+"""Round-trip check of the converted projector through tcclaviger's own loaders, on the CPU, inside his image.
+
+Runs in tcclaviger/vllm:29.08.10 with no GPU: `import vllm` probes the ROCm device, so his two files are loaded
+unmodified by path (vllm/v1/ced.py as vllm.v1.ced, vllm/models/qwen4_exp/amd/ced.py as its package's ced) with
+stand-ins for the few vllm names they import at module level (logger, TP rank / all-reduce, forward context,
+the GDN layer-name encoder), none of which the loaders below call. Then, with the run's environment:
+  resolve_bundle      the bundle the engine resolves: projector file, correction rank files, alpha, xrows, freq
+  projector_taps      split 24, taps (24,)
+  Projector (torch)   every layer.L weight / bias equals bf16(codes * scale) / bf16(bias) recomputed here from the
+                      release files, bit for bit; final equals the source file's final
+  StCorrection        for TP 2 rank 0 and 1 (and TP 1), each layer's slice equals the release's st.L heads
+                      [r * 24, (r + 1) * 24) bit for bit, alpha 1
+  XrowsSelector       his class mask (from the tokenizer) selects exactly the release's finite-score ids, and his
+                      rows() on seeded random prompts equals the release's own ranking (rarest share by score, ties by
+                      position) at shares 0.10 / 0.25 / 0.50 / 1.0
+Writes a JSON report (argv[1], default stdout) and exits non-zero on the first failure.
+
+docker run --rm --network none -e HIP_VISIBLE_DEVICES= -v KIT:/kit:ro -v TCC:/tcc:ro -v SRC:/src:ro -v MODEL:/model:ro
+  -v FINALSRC:/finalsrc:ro --entrypoint python tcclaviger/vllm:29.08.10 -I /kit/c5/engine_check.py /out/report.json
+"""
+import importlib.util
+import json
+import logging
+import os
+import sys
+import types
+from pathlib import Path
+
+import torch
+
+VLLM = Path("/opt/vllm/lib/python3.14/site-packages/vllm")
+TCC, SRC, MODEL = Path("/tcc"), Path("/src"), Path("/model")
+FINALSRC = Path(os.environ.get("C5_FINAL_SOURCE", "/finalsrc/kva-big-s24.safetensors"))
+SPLIT, LAYERS, HEADS = 24, 48, 48
+
+
+class _Log(logging.LoggerAdapter):
+    def info_once(self, msg, *a, **k):
+        self.info(msg, *a)
+
+    def warning_once(self, msg, *a, **k):
+        self.warning(msg, *a)
+
+    def process(self, msg, kwargs):
+        kwargs.pop("scope", None)
+        return msg, kwargs
+
+
+def _stub(name, **attrs):
+    m = types.ModuleType(name)
+    m.__path__ = []
+    m.__dict__.update(attrs)
+    sys.modules[name] = m
+    return m
+
+
+def load_his():
+    """(vllm.v1.ced, the model-side ced) loaded from the image's files, unmodified."""
+    _stub("vllm")
+    _stub("vllm.logger", init_logger=lambda n: _Log(logging.getLogger(n), {}))
+    _stub("vllm.distributed", get_tensor_model_parallel_rank=lambda: 0,
+          tensor_model_parallel_all_reduce=lambda x: x)
+    _stub("vllm.forward_context", get_forward_context=lambda: None)
+    for p in ("vllm.model_executor", "vllm.model_executor.layers", "vllm.model_executor.layers.mamba",
+              "vllm.model_executor.layers.mamba.gdn"):
+        _stub(p)
+    _stub("vllm.model_executor.layers.mamba.gdn.qwen_gdn_linear_attn", _encode_layer_name=lambda s: s)
+    _stub("vllm.v1")
+    for p in ("vllm.models", "vllm.models.qwen4_exp", "vllm.models.qwen4_exp.amd"):
+        _stub(p)
+
+    def load(name, path):
+        spec = importlib.util.spec_from_file_location(name, path)
+        mod = importlib.util.module_from_spec(spec)
+        sys.modules[name] = mod
+        spec.loader.exec_module(mod)
+        return mod
+
+    eng = load("vllm.v1.ced", VLLM / "v1" / "ced.py")
+    model = load("vllm.models.qwen4_exp.amd.ced", VLLM / "models" / "qwen4_exp" / "amd" / "ced.py")
+    return eng, model
+
+
+def release_tensors(name):
+    from safetensors.torch import load_file
+    return load_file(str(SRC / name))
+
+
+def reference_rows(score, ids, P, share):
+    """The release's own class56 rule on its score table: eligible = finite score, the rarest share (highest score),
+    ties by position, ascending positions."""
+    t = torch.as_tensor(ids[:P], dtype=torch.long)
+    s = score[t]
+    m = torch.isfinite(s).nonzero().flatten()
+    if m.numel() == 0:
+        return ()
+    k = round(share * m.numel())
+    if k >= m.numel():
+        return tuple(m.tolist())
+    if k <= 0:
+        return ()
+    order = torch.argsort(s[m], descending=True, stable=True)[:k]
+    return tuple(sorted(m[order].tolist()))
+
+
+def main(out=None):
+    report, fail = {}, []
+
+    def check(name, ok, detail=""):
+        report[name] = {"ok": bool(ok), "detail": detail}
+        if not ok:
+            fail.append(name)
+
+    eng, his = load_his()
+    proj = TCC / "ridgefill-s24.safetensors"
+    os.environ.update(DYLUHN_KVA="1", DYLUHN_KVA_PROJECTOR=str(proj), DYLUHN_KVA_ST="ridgefill-s24-st",
+                      DYLUHN_KVA_XROWS="class56:0.25")
+    b = eng.resolve_bundle(str(proj))
+    check("bundle", b.projector == str(proj) and b.st_base == "ridgefill-s24-st" and b.st_alpha == 1.0
+          and [Path(p).name for p in b.st_files] == ["ridgefill-s24-st.rank0.pt", "ridgefill-s24-st.rank1.pt"]
+          and b.xrows == {"rule": "class56", "share": 0.25, "classes": ("cap", "mixed", "piece")}
+          and Path(b.freq).name == "freq.safetensors" and b.kind == "quality", repr(b))
+    os.environ["DYLUHN_KVA_ST"] = "0"
+    os.environ["DYLUHN_KVA_XROWS"] = "0"
+    b0 = eng.resolve_bundle(str(proj))
+    check("bundle_plain", b0.kind == "plain" and not b0.st_files and b0.xrows is None, repr(b0))
+    check("taps", eng.projector_taps(str(proj), LAYERS) == (SPLIT,), str(eng.projector_taps(str(proj), LAYERS)))
+
+    cfg = types.SimpleNamespace(num_hidden_layers=LAYERS, hc_count=4, hidden_size=2560, linear_num_value_heads=HEADS)
+    P = his.Projector(str(proj), torch.device("cpu"), cfg, impl="torch")
+    check("projector_split", P.split == SPLIT and P.names == [f"layer.{i}" for i in range(SPLIT, LAYERS)] + ["final"])
+    bad = []
+    for L in range(SPLIT, LAYERS):
+        t = release_tensors(f"proj8.L{L}.safetensors")
+        c, s, bias = t[f"proj.{L}.codes"], t[f"proj.{L}.scale"], t[f"proj.{L}.bias"]
+        w = (c.float().view(2560, 80, 128) * s.float()[:, :, None]).view(2560, 10240).to(torch.bfloat16)
+        if not (torch.equal(P.weight[f"layer.{L}"], w) and torch.equal(P.bias[f"layer.{L}"], bias)):
+            bad.append(L)
+    check("projector_maps_bitwise", not bad, f"layers differing: {bad}")
+    if FINALSRC.is_file():
+        from safetensors import safe_open
+        with safe_open(str(FINALSRC), "pt") as f:
+            fin = f.get_tensor("final")
+        check("projector_final_source", torch.equal(P.weight["final"], fin[:, :-1]) and
+              torch.equal(P.bias["final"], fin[:, -1]))
+    else:
+        report["projector_final_source"] = {"ok": None, "detail": f"{FINALSRC} not mounted"}
+
+    os.environ["DYLUHN_KVA_ST"] = "ridgefill-s24-st"
+    bst = eng.resolve_bundle(str(proj))
+    st = release_tensors("correction.safetensors")
+    for tp in (1, 2):
+        for rank in range(tp):
+            C = his.StCorrection(bst, cfg, torch.device("cpu"), rank, tp)
+            local = HEADS // tp
+            bad = [L for L in C.correction if not torch.equal(
+                C.correction[L], st[f"st.{L}"][rank * local:(rank + 1) * local])]
+            layers = sorted(C.correction)
+            check(f"correction_tp{tp}_rank{rank}", not bad and C.alpha == 1.0 and
+                  layers == sorted(int(k.split(".")[1]) for k in st), f"layers {layers}, differing {bad}")
+
+    from transformers import AutoTokenizer
+    tok = AutoTokenizer.from_pretrained(str(MODEL))
+    score = release_tensors("rowsel.safetensors")["score"]
+    for share in (0.10, 0.25, 0.50, 1.0):
+        sel = eng.XrowsSelector(eng.parse_xrows(f"class56:{share}"), str(TCC / "freq.safetensors"), tok)
+        if share == 0.25:
+            elig = torch.isin(sel.cls, sel.want)
+            fin = torch.isfinite(score[:sel.vocab])
+            diff = (elig != fin).nonzero().flatten()
+            check("class_mask_equal", diff.numel() == 0 and int(torch.isfinite(score[sel.vocab:]).sum()) == 0,
+                  f"engine {int(elig.sum())} eligible, release {int(fin.sum())}; differing ids {diff[:20].tolist()}")
+        g = torch.Generator().manual_seed(20261008)
+        mism = 0
+        for trial in range(40):
+            n = int(torch.randint(600, 6000, (1,), generator=g))
+            ids = torch.randint(0, sel.vocab, (n,), generator=g).tolist()
+            # repeats exercise the stable tie-break by position
+            ids += ids[: n // 4]
+            P_ = len(ids) - 512
+            if sel.rows(ids, P_) != reference_rows(score, ids, P_, share):
+                mism += 1
+        check(f"xrows_rows_share{share:g}", mism == 0, f"{mism} of 40 prompts differ")
+    report["_summary"] = {"failed": fail, "image_vllm": str(VLLM)}
+    text = json.dumps(report, indent=1)
+    if out:
+        Path(out).write_text(text + "\n")
+    print(text)
+    return 1 if fail else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1] if len(sys.argv) > 1 else None))
diff --git a/c5/kfilter.sh b/c5/kfilter.sh
new file mode 100755
index 0000000..565a6f3
--- /dev/null
+++ b/c5/kfilter.sh
@@ -0,0 +1,12 @@
+#!/bin/bash
+# c5/kfilter.sh SINCE -> exit 1 only on UNRECOVERABLE amdgpu faults since SINCE (the run stops only on faults it
+# cannot recover from): a failed GPU reset or recovery, a device lost or lost from the bus, or
+# an SMU hang (09-30: the SMU hung, the reset failed, only a reboot helped). Everything else tools/kcheck.sh reports
+# (MES timeouts, ring timeouts, successful resets, the overdrive warning) is recoverable: logged by the watchdog, never
+# a stop. Prints the unrecoverable lines. KCHECK overrides the checker (tests).
+KCHECK=${KCHECK:-$(cd "$(dirname "$0")/.." && pwd)/tools/kcheck.sh}
+UNREC='reset failed|reset.*(fail|timed out)|recover(y)? failed|failed to recover|device lost|lost from bus|SMU is in hanged state|SMU.*hang'
+out=$("$KCHECK" "$1") && exit 0
+bad=$(printf '%s\n' "$out" | grep -iE "$UNREC") || exit 0
+printf '%s\n' "$bad"
+exit 1
diff --git a/c5/randctl.py b/c5/randctl.py
new file mode 100644
index 0000000..52e32b8
--- /dev/null
+++ b/c5/randctl.py
@@ -0,0 +1,58 @@
+"""PROPOSED substitute for the registered random-25%-rows control (not run unless the coordinator chooses it).
+
+The engine has one exact-row rule (vllm/v1/ced.py XrowsSelector, class56): among the prompt rows whose token is in the
+classes cap / mixed / piece, keep round(share x count) by rarity (-logfreq of the unigram table). A random-rows rule
+is not expressible. The closest substitute that needs no engine change is a unigram table whose values are a seeded
+permutation of the real table's values over the eligible ids: the engine then keeps the same number of rows of the
+same classes, chosen by a random order of token identities instead of by rarity. It is count- and class-matched and
+rarity-blind; it is NOT position-random (every occurrence of a token id is in or out together) and NOT drawn from all
+rows (only class56 rows). It answers "does ranking by rarity matter at a fixed class budget", not "do these classes
+matter". Ineligible ids keep 0.0 (never read).
+
+Usage: python -m c5.randctl --freq <projector-tcc>/freq.safetensors --out <dir>/freq-shuffled-<seed>.safetensors
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+import torch
+from safetensors.torch import load, save
+
+from kva.integrity import read_direct
+
+SEED = 20261008
+
+
+def shuffled(logfreq, eligible, seed=SEED):
+    g = torch.Generator().manual_seed(seed)
+    idx = eligible.nonzero().flatten()
+    perm = idx[torch.randperm(idx.numel(), generator=g)]
+    out = logfreq.clone()
+    out[idx] = logfreq[perm]
+    return out
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--freq", required=True)
+    ap.add_argument("--src-score", required=True, help="the release's rowsel.safetensors (eligible = finite score)")
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--seed", type=int, default=SEED)
+    a = ap.parse_args(argv)
+    lf = load(read_direct(a.freq))["logfreq"]
+    elig = torch.isfinite(load(read_direct(a.src_score))["score"])
+    out = shuffled(lf, elig, a.seed)
+    b = save({"logfreq": out}, metadata={"c5": json.dumps({"rule": "seeded permutation of logfreq over the class56-"
+                                                           "eligible ids (c5/randctl.py)", "seed": a.seed,
+                                                           "from": Path(a.freq).name}, sort_keys=True)})
+    Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+    Path(a.out).write_bytes(b)
+    if read_direct(a.out) != b:
+        raise SystemExit("read-back differs")
+    print(hashlib.sha256(b).hexdigest(), a.out)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/c5/run_c5.sh b/c5/run_c5.sh
