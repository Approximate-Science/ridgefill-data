+    def after_panel(self, panel):
+        if self.pending:
+            return [pending_note("flashnext")] if panel == 1 else []
+        if panel != 1:
+            return []
+        e = self.run.cell("flashnext note: engine and determinism read", self.engine, lambda v: "ok", "engine-final")
+        if e != "ok":
+            return []
