+    if kind == "speed":
+        return [run(f"ttft-{f.replace('/', '-')}", "ttft", f, "primary" if f == "3/8" else "curve",
+                    PRIMARY[:5] if f == "3/8" else CURVE) for f in ("1/4", "3/8", "1/2", "5/8")]
