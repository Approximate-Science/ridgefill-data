+FIT_OPEN = [r"\ifdefined\genfitbox\else\newsavebox{\genfitbox}\fi% DEV-18", r"\sbox{\genfitbox}{% DEV-18"]
+FIT_CLOSE = [r"}% DEV-18", r"\ifdim\wd\genfitbox>\linewidth\resizebox{\linewidth}{!}{\usebox{\genfitbox}}"
