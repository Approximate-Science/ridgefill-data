+    PR, p = kvabackend._protocol()
+    m = p["models"][cell["model"]["name"]]
+    return {r["split"]: kvabackend.layer_of(m, r["split"]) for r in cell["runs"] if r.get("model") != "swiftkv"}, m
+
+
