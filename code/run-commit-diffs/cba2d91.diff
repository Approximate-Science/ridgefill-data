+def doc_label(doc):
+    dom, length, idx = doc_key(doc)
+    if not length:
+        return tex_escape(str(doc))
+    k = length // 1000 if length % 1000 == 0 else length // 1024          # 128000 -> 128K, 8192 -> 8K
+    return f"{tex_escape(DOC_DOMAIN.get(dom, dom))} {k}K-{idx}"
