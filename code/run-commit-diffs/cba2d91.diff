+                           model="swiftkv", lengths=L32))
+        return out
+    if kind == "longbench":                        # re-added for Llama only on 2026-10-08, primary arms, no SwiftKV run
+        return [run("longbench", "longbench", "3/8", "primary", PRIMARY)]
+    if kind == "nll":
