new file mode 100644
index 0000000..980b47a
--- /dev/null
+++ b/c5/smoke.py
@@ -0,0 +1,96 @@
+"""C5 smoke test on one booted RidgeFill server (the graded arm's boot). Never reads the locked set: the prompts are
+token ids of the repo's own markdown (paper/, docs/), repeated to length, so nothing here is test data.
+
+Checks, in order (each printed and written to <out>/smoke.json):
+  1  /health and the served model
+  2  RidgeFill engages: a 16K prompt_logprobs request with dyluhn_kva=1 returns every prompt position (the scored
+     tail is checked by the caller against the server log's "CED request ... approximated" line)
+  3  determinism: the same 16K prompt_logprobs request twice on the exact path (dyluhn_kva=0) and twice with
+     RidgeFill; bitwise-equal logprobs or the max |difference| (the deterministic top-k question, protocol.json
+     engine_tier.final_requires)
+  4  generation: 32 greedy tokens at 16K, both paths
+  5  timing: one TTFT per path at 9,216 / 16,384 / 32,768 tokens (the rates the plan re-estimates from) and one
+     prompt_logprobs pass at 32K per path (the perplexity rate)
+  6  the longest RULER row fits: one 65,408-token request, max_tokens 1 (exact path), unless --no-64k
+Exit 0 when every request succeeded; the determinism result is reported, not judged.
+"""
+import argparse
+import json
+import time
+from pathlib import Path
+
+from c5.client import Client, write_json, parse_prompt_logprobs, ttft, tokenizer, ids_sha
+
+REPO = Path(__file__).resolve().parents[1]
+
+
+def filler_ids(tok, n):
+    text = "\n\n".join(p.read_text(errors="replace") for d in ("paper", "docs") for p in sorted((REPO / d).rglob("*.md"))
+                       if "test-set-locked" not in str(p))
+    base = tok(text, add_special_tokens=False).input_ids
+    if not base:
+        raise SystemExit("no filler text")
+    out = []
+    while len(out) < n:
+        out += base
+    return out[:n]
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--base-url", default="http://127.0.0.1:8079")
+    ap.add_argument("--tail", type=int, default=2048)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--no-64k", action="store_true")
+    a = ap.parse_args(argv)
+    cl = Client(a.base_url, 1, a.tail)
+    rep = {"t0": time.time()}
+    if not cl.healthy():
+        raise SystemExit("not healthy")
+    tok = tokenizer()
+    ids16 = filler_ids(tok, 16384)
+    rep["filler_sha256"] = ids_sha(ids16)
+
+    def logprob_pass(ids, kva, tag):
+        reply, wall, _ = cl.post(cl.body(ids, 1, f"c5-smoke-{tag}-{time.time()}", kva=kva, prompt_logprobs=0))
+        return parse_prompt_logprobs(reply, ids), wall, reply.get("id")
+
+    for kva in (1, 0):
+        lp1, w1, id1 = logprob_pass(ids16, kva, f"lp{kva}a")
+        lp2, w2, id2 = logprob_pass(ids16, kva, f"lp{kva}b")
+        diff = max(abs(x - y) for x, y in zip(lp1, lp2))
+        tail = lp1[-512:]
+        rep[f"logprobs_kva{kva}"] = dict(bitwise_equal=lp1 == lp2, max_abs_diff=diff, wall_s=[w1, w2], ids=[id1, id2],
+                                         tail512_mean_nll=-sum(tail) / len(tail))
+        print(f"logprobs dyluhn_kva={kva}: two passes bitwise equal {lp1 == lp2}, max |diff| {diff:.3g}, "
+              f"walls {w1:.1f}s {w2:.1f}s, tail-512 mean NLL {-sum(tail) / len(tail):.4f}", flush=True)
+    for kva in (1, 0):
+        reply, wall, _ = cl.post(cl.body(ids16, 32, f"c5-smoke-gen{kva}", kva=kva))
+        ch = reply["choices"][0]
+        rep[f"gen_kva{kva}"] = dict(finish=ch.get("finish_reason"), tokens=reply["usage"]["completion_tokens"],
+                                    wall_s=wall, id=reply.get("id"), text_sha256=ids_sha(ch["text"]))
+        print(f"generation dyluhn_kva={kva}: {reply['usage']['completion_tokens']} tokens, {wall:.1f}s", flush=True)
+    rep["ttft"] = {}
+    for L in (9216, 16384, 32768):
+        ids = filler_ids(tok, L)
+        for kva in (1, 0):
+            r = ttft(cl, ids, f"c5-smoke-ttft-{L}-{kva}-{time.time()}", kva=kva)
+            rep["ttft"][f"{L}-kva{kva}"] = r
+            print(f"ttft {L} dyluhn_kva={kva}: {r['ttft_s']:.2f}s ({L / r['ttft_s']:.0f} tok/s)", flush=True)
+    ids32 = filler_ids(tok, 32768)
+    for kva in (1, 0):
+        _, wall, rid = logprob_pass(ids32, kva, f"lp32-{kva}")
+        rep[f"ppl32_kva{kva}"] = dict(wall_s=wall, id=rid, tok_s=32768 / wall)
+        print(f"prompt_logprobs 32K dyluhn_kva={kva}: {wall:.1f}s ({32768 / wall:.0f} tok/s)", flush=True)
+    if not a.no_64k:
+        ids64 = filler_ids(tok, 65408)
+        r = ttft(cl, ids64, f"c5-smoke-64k-{time.time()}", kva=0)
+        rep["ttft_64k_exact"] = r
+        print(f"64K exact path: ttft {r['ttft_s']:.1f}s", flush=True)
+    rep["t1"] = time.time()
+    write_json(Path(a.out) / "smoke.json", rep)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/c5/watchdog.sh b/c5/watchdog.sh
new file mode 100755
index 0000000..cb52129
--- /dev/null
+++ b/c5/watchdog.sh
@@ -0,0 +1,63 @@
+#!/bin/bash
+# c5/watchdog.sh SINCE DRIVER_PID CONTAINER SAFETY_DIR: qfn/watchdog.sh for the C5 run. Since 2026-10-08 18:4x
+# (Dylan) it stops ONLY on unrecoverable faults (c5/kfilter.sh); MES/ring timeouts, page faults and VRAM are logged. Every 5 s: tools/kcheck.sh
+# (amdgpu MES / SMU / ring timeout / GPU reset / device lost since SINCE) and amdgpu page / memory-access faults; VRAM
+# per R9700 (log above 27 GiB, stop above 31 GiB); every 60 s the host's early signs (page migrations, compaction
+# stalls, KFD evicted time, the container's cgroup). On a hit: write SAFETY_DIR/KERNEL-ALERT, kill the driver, save
+# the container log, stop and remove the container, save the kernel log since SINCE, exit 1. run_c5.sh refuses to
+# boot while any KERNEL-ALERT exists. Exit 0 once the driver is gone and the container is not running.
+REPO=$(cd "$(dirname "$0")/.." && pwd)
+SINCE="$1"; DRIVER="$2"; C="$3"; D="$4"
+KCHECK=$REPO/c5/kfilter.sh          # tools/kcheck.sh, riding through isolated MES TLB timeouts (c5/kfilter.sh)
+DOCKER=${DOCKER:-docker}
+# C5_WATCH_PCI: the PCI addresses of the cards the run uses, space-separated (as lspci -D prints them)
+WATCH=${C5_WATCH_PCI:?set C5_WATCH_PCI to the PCI addresses of the cards the run uses}
+WARN=$((27 * 1024 * 1024 * 1024)); GUARD=$((31 * 1024 * 1024 * 1024))
+mkdir -p "$D"
+CARDS=""
+for c in /sys/class/drm/card[0-9]; do
+  case " $WATCH " in *" $(basename "$(readlink -f "$c/device")") "*) CARDS="$CARDS $c/device/mem_info_vram_used";; esac
+done
+echo "watchdog pid $$ since $SINCE driver $DRIVER container $C cards$CARDS started $(date -Is)" >> $D/watchdog.log
+peak=0; tick=0; last_cs=""; last_tol=0
+signs() {
+  local mig ev cg free cs
+  mig=$(awk '/^pgmigrate_success/{m=$2} /^compact_stall/{c=$2} /^thp_fault_alloc/{t=$2} END{print "pgmigrate=" m " compact_stall=" c " thp_fault=" t}' /proc/vmstat)
+  ev=$(cat /sys/class/kfd/kfd/proc/*/stats_*/evicted_ms 2>/dev/null | awk '{s+=$1} END{print s+0}')
+  cg=$(find /sys/fs/cgroup/user.slice -maxdepth 6 -type d -name "docker-*.scope" 2>/dev/null | head -1)
+  free=$(awk '/^MemFree:/{printf "%.1f", $2/2^20}' /proc/meminfo)
+  echo "$(date -Is) signs $mig kfd_evicted_ms=$ev cg_current_gib=$([ -n "$cg" ] && awk '{printf "%.1f", $1/2^30}' $cg/memory.current 2>/dev/null || echo -) memfree_gib=$free" >> $D/watchdog.log
+  cs=${mig##*compact_stall=}; cs=${cs%% *}
+  [ -n "$last_cs" ] && [ "$cs" != "$last_cs" ] && echo "$(date -Is) EARLY SIGN: compact_stall $last_cs -> $cs" >> $D/watchdog.log
+  last_cs=$cs
+}
+while true; do
+  reason=""
+  tick=$((tick + 1)); [ $((tick % 12)) -eq 1 ] && signs
+  for f in $CARDS; do
+    used=$(cat "$f" 2>/dev/null || echo 0)
+    [ "$used" -gt "$peak" ] && peak=$used && echo "$(date -Is) VRAM peak $((peak / 1048576)) MiB ($f)" >> $D/watchdog.log
+    [ "$used" -gt "$GUARD" ] && echo "$(date -Is) VRAM above 31 GiB on $f: $((used / 1048576)) MiB (logged, not a stop)" >> $D/watchdog.log
+  done
+  if ! out=$($KCHECK "$SINCE"); then reason="kernel${reason:++$reason}"; fi
+  tol=$($REPO/tools/kcheck.sh "$SINCE" | grep -c .)
+  [ "$tol" -gt "$last_tol" ] && { echo "$(date -Is) RECOVERABLE amdgpu lines since $SINCE: $tol (logged, not a stop):"; $REPO/tools/kcheck.sh "$SINCE" | tail -n $((tol - last_tol)); } >> $D/watchdog.log
+  last_tol=$tol
+  pfn=$(journalctl -k --since "$SINCE" -o short-iso | grep -cE "amdgpu.*(page fault|Memory access fault|PROTECTION_FAULT)")
+  [ "$pfn" -gt "${last_pf:-0}" ] && echo "$(date -Is) amdgpu page-fault lines since $SINCE: $pfn (recoverable: logged, not a stop)" >> $D/watchdog.log
+  last_pf=$pfn
+  if [ -n "$reason" ]; then
+    { echo "KERNEL ALERT ($reason) at $(date -Is) (since $SINCE)"; echo "$out"; } > $D/KERNEL-ALERT
+    kill "$DRIVER" 2>/dev/null
+    $DOCKER logs "$C" > $D/alert-$C.log 2>&1
+    $DOCKER stop -t 10 "$C"; $DOCKER rm "$C"
+    journalctl -k --since "$SINCE" -o short-iso > $D/alert-kernel.log
+    echo "fired ($reason) $(date -Is)" >> $D/watchdog.log
+    exit 1
+  fi
+  if ! kill -0 "$DRIVER" 2>/dev/null && [ "$($DOCKER inspect -f '{{.State.Running}}' $C 2>/dev/null)" != true ]; then
+    echo "driver gone, container not running: clean exit $(date -Is); VRAM peak $((peak / 1048576)) MiB" >> $D/watchdog.log
+    exit 0
+  fi
+  sleep 5
+done
