+def visible_len(cell):
+    t = cell.replace(r"\method", "RidgeFill").replace(r"\llamashort", "Llama-3.1-8B")
+    t = re.sub(r"\\[A-Za-z]+\*?", "", t)
+    return len(re.sub(r"[{}$]", "", t).strip())
